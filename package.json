{
  "name": "relay-notification-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Local prototype for the Relay notification platform",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate:up": "node --env-file-if-exists=.env scripts/migrate.js"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "pg-connection-string": "^2.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "node-pg-migrate": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
