# Safe placeholders only. Never put real credentials or secrets in this file.
# The initial prototype accepts only a local PostgreSQL URL, not a Neon URL.
DATABASE_URL=
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Dedicated request-fingerprint secret, distinct from tenant API credentials
# and raw idempotency keys. Use canonical padded standard Base64 representing at
# least 32 decoded bytes. Generate it locally; never commit or paste the value.
RELAY_FINGERPRINT_HMAC_KEY=
RELAY_FINGERPRINT_HMAC_KEY_VERSION=1

# During rotation, retain prior keys as RELAY_FINGERPRINT_HMAC_KEY_V<version>
# with the same Base64 and minimum-length rules, until no retained reservation
# references that version.
# RELAY_FINGERPRINT_HMAC_KEY_V1=

# Deterministic modes: success, retryable_failure, permanent_failure,
# timeout_ambiguous. These settings are validated but providers are not part
# of Phase 1.
FAKE_EMAIL_MODE=success
FAKE_PUSH_MODE=success
